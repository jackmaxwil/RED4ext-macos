#!/bin/bash
# Unattended Cyberpunk 2077 test run (RESUME_PLAN Phase T).
#
#   tools/cp-run <scenario> [--timeout SECONDS] [--keep-settings]
#
# Scenarios:
#   boot      No autotest. Core hook allowlist from $CP_CORE_HOOKS (default: CGameApplication_AddState);
#             plugins from $CP_PLUGINS (comma-separated directory names; default: none).
#             Pass = every installed hook has hits >= 1, Running state entered, no crash report.
#   <other>   Installs tools/autotest for one run (same CP_CORE_HOOKS / CP_PLUGINS). Pass also requires every CPAUTOTEST
#             CHECK line on stdout to pass and a DONE event (collected into results.json).
#
# Launches the game binary directly with RED4ext injected, in a 1280x720 window.
# The user's UserSettings.json and red4ext/config.ini are backed up and restored on any exit.
# Artifacts go to RED4ext/runs/<timestamp>-<scenario>/. Exit: 0 pass, 1 fail, 2 precondition error.
set -euo pipefail

SCENARIO=${1:?usage: cp-run <scenario> [--timeout SECONDS] [--keep-settings]}
shift
TIMEOUT=""
KEEP_SETTINGS=0
while [[ $# -gt 0 ]]; do
    case "$1" in
    --timeout) TIMEOUT=$2; shift 2 ;;
    --keep-settings) KEEP_SETTINGS=1; shift ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
done
case "$SCENARIO" in
boot) : "${TIMEOUT:=120}" ;;
soak) : "${TIMEOUT:=3900}" ;;
*) : "${TIMEOUT:=300}" ;;
esac

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GAME_DIR="${CP2077_GAME_DIR:-$HOME/Library/Application Support/Steam/steamapps/common/Cyberpunk 2077}"
GAME_BIN="$GAME_DIR/Cyberpunk2077.app/Contents/MacOS/Cyberpunk2077"
R4E_DIR="$GAME_DIR/red4ext"
LOGS_DIR="$R4E_DIR/logs"
SETTINGS="$HOME/Library/Application Support/CD Projekt Red/Cyberpunk 2077/UserSettings.json"
RUN_DIR="$TOOLS_DIR/../runs/$(date +%Y%m%d-%H%M%S)-$SCENARIO"
mkdir -p "$RUN_DIR/backup"

say() { echo "[cp-run] $*"; }
die() { say "PRECONDITION: $*"; exit 2; }

# --- preconditions --------------------------------------------------------------------------------
[[ -x "$GAME_BIN" ]] || die "game binary not found: $GAME_BIN"
[[ -f "$R4E_DIR/RED4ext.dylib" ]] || die "RED4ext.dylib not installed in $R4E_DIR (run tools/cp-dev)"
pgrep -x Cyberpunk2077 >/dev/null && die "the game is already running"
codesign -d --entitlements - "$GAME_BIN" 2>/dev/null | grep -q allow-unsigned-executable-memory ||
    die "game binary lacks allow-unsigned-executable-memory; run: scripts/codesign_macos.sh exe \"$GAME_BIN\""
# Steam is deliberately not started: launching it (signed out) pops a login window, and the game runs without it.

# --- backup + test profile ------------------------------------------------------------------------
cp -p "$SETTINGS" "$RUN_DIR/backup/UserSettings.json"
[[ -f "$R4E_DIR/config.ini" ]] && cp -p "$R4E_DIR/config.ini" "$RUN_DIR/backup/config.ini"
CACHE="$GAME_DIR/r6/cache"
AUTOTEST_DIR="$GAME_DIR/r6/scripts/cp_autotest"
cp -p "$CACHE"/final.redscripts* "$RUN_DIR/backup/"
GAME_PID=""
restore() {
    [[ -n "$GAME_PID" ]] && kill -9 "$GAME_PID" 2>/dev/null || true
    if [[ $KEEP_SETTINGS -eq 0 ]]; then
        cp -p "$RUN_DIR/backup/UserSettings.json" "$SETTINGS"
    fi
    if [[ -f "$RUN_DIR/backup/config.ini" ]]; then cp -p "$RUN_DIR/backup/config.ini" "$R4E_DIR/config.ini"; else rm -f "$R4E_DIR/config.ini"; fi
    rm -rf "$AUTOTEST_DIR" "$GAME_DIR/r6/scripts/zz_red4ext_plugins" "$GAME_DIR/r6/tweaks/cp_autotest.yaml"
    cp -p "$RUN_DIR/backup"/final.redscripts* "$CACHE/"
}
trap restore EXIT

python3 - "$SETTINGS" <<'EOF'
import json, sys
p = sys.argv[1]
d = json.load(open(p))
for g in d["data"]:
    for o in g.get("options", []):
        if g["group_name"] == "/video/display" and o["name"] == "WindowMode":
            o["value"], o["index"] = "Windowed", 0
        if g["group_name"] == "/video/display" and o["name"] == "Resolution":
            # The index points into the monitor's runtime resolution list, which is not stored here; drop it so the
            # game matches by value instead of keeping the native resolution's index.
            o["value"] = "1280x720"
            o.pop("index", None)
json.dump(d, open(p, "w"), indent=2)
EOF

CORE_HOOKS=${CP_CORE_HOOKS:-CGameApplication_AddState}
# CP_PLUGINS: comma-separated plugin directory names to load; every other installed plugin is ignored.
PLUGINS_ENABLED=false
ignored_list=""
if [[ -n "${CP_PLUGINS:-}" ]]; then
    PLUGINS_ENABLED=true
    for d in "$R4E_DIR"/plugins/*/; do
        name=$(basename "$d")
        [[ ",$CP_PLUGINS," == *",$name,"* ]] || ignored_list+="\"$name\", "
    done
fi
core_list=""
IFS=, read -ra hooks <<<"$CORE_HOOKS"
for h in "${hooks[@]}"; do [[ -n "$h" ]] && core_list+="\"$h\", "; done
cat >"$R4E_DIR/config.ini" <<EOF
version = 0

[dev]
console = false
wait_for_debugger = false
strict_version_check = true

[logging]
flush_on = "debug"
level = "debug"
max_file_size = 10
max_files = 5

[plugins]
enabled = $PLUGINS_ENABLED
ignored = [${ignored_list%, }]

[hooking]
backend = "native_inline"
core_hooks = [${core_list%, }]
EOF

# --- autotest scripts (non-boot scenarios) --------------------------------------------------------
if [[ "$SCENARIO" != boot ]]; then
    mkdir -p "$AUTOTEST_DIR"
    cp "$TOOLS_DIR/autotest/"*.reds "$AUTOTEST_DIR/"
    scenario_checks="$TOOLS_DIR/autotest/scenarios/$SCENARIO.reds"
    [[ -f "$scenario_checks" ]] || scenario_checks="$TOOLS_DIR/autotest/scenarios/default.reds"
    cp "$scenario_checks" "$AUTOTEST_DIR/ScenarioChecks.reds"
    printf 'module CpAutotest\n\npublic func CpAutotestScenario() -> String = "%s";\n' "$SCENARIO" >"$AUTOTEST_DIR/Scenario.reds"
    # Optional TweakXL input for the scenario; removed again on exit.
    if [[ -f "$TOOLS_DIR/autotest/scenarios/$SCENARIO.yaml" ]]; then
        mkdir -p "$GAME_DIR/r6/tweaks"
        cp "$TOOLS_DIR/autotest/scenarios/$SCENARIO.yaml" "$GAME_DIR/r6/tweaks/cp_autotest.yaml"
    fi
fi

# --- launch ---------------------------------------------------------------------------------------
rm -f "$LOGS_DIR/hookstats.json" "$LOGS_DIR/milestones.log" "$LOGS_DIR/autotest.log" "$LOGS_DIR/rtti_layout_macos.json"
# Plugin scripts are compiled only for loaded plugins: a plugin's scripts declare its natives, and a declared native
# that no loaded plugin registered makes the game fail to initialize the script data. scc takes one directory, so
# enabled plugins' Scripts folders are staged under r6/scripts for the compile.
STAGE="$GAME_DIR/r6/scripts/zz_red4ext_plugins"
rm -rf "$STAGE"
# rttidump records what plugins register natively, so it compiles no plugin scripts.
if [[ "$PLUGINS_ENABLED" == true && "$SCENARIO" != rttidump ]]; then
    IFS=, read -ra enabled <<<"$CP_PLUGINS"
    for name in "${enabled[@]}"; do
        [[ -d "$R4E_DIR/plugins/$name/Scripts" ]] || continue
        # Same gate as the launcher: a refused plugin's script natives would stop the game at script init.
        if ! "$R4E_DIR/bin/red4ext_plugin_check" "$R4E_DIR/bin/x64/cyberpunk2077_addresses.json" \
            "$R4E_DIR/plugins/$name/"*.dylib >/dev/null 2>&1; then
            say "not compiling $name's scripts: the loader will refuse it"
            continue
        fi
        mkdir -p "$STAGE" && cp -R "$R4E_DIR/plugins/$name/Scripts" "$STAGE/$name"
    done
fi
[[ -x "$GAME_DIR/engine/tools/scc" ]] && "$GAME_DIR/engine/tools/scc" -compile "$GAME_DIR/r6/scripts" >"$RUN_DIR/scc.log" 2>&1 || true
# Never launch into the game's "REDscript compilation has failed" dialog: fail the run with the compiler errors.
if grep -q "Compilation failed" "$RUN_DIR/scc.log" 2>/dev/null; then
    grep -A3 "^\[ERROR" "$RUN_DIR/scc.log" | head -40
    say "FAIL $SCENARIO: redscript compilation failed (see $RUN_DIR/scc.log)"
    exit 1
fi
[[ -x "$GAME_DIR/engine/tools/inputloader.pl" ]] && "$GAME_DIR/engine/tools/inputloader.pl" >"$RUN_DIR/inputloader.log" 2>&1 || true

START=$(date +%s)
touch "$RUN_DIR/.start"
say "launching ($SCENARIO, timeout ${TIMEOUT}s, core_hooks=[${CORE_HOOKS}], plugins=[${CP_PLUGINS:-}])"
# The start screen is where the game loads the player profile; with -skipStartScreen the menu shows no saves. Scenarios
# that load a save (CP_PRESS_START=1) keep the start screen and press Space on it from the watch loop.
START_ARGS=-skipStartScreen
[[ "${CP_PRESS_START:-0}" == 1 ]] && START_ARGS=""
# Started outside Steam, the game's SteamAPI_Init has no app ID, fails, and the game then shows no saves. Pass the ID
# Steam itself sets, but only when Steam is already running: tooling never starts Steam (that pops its login window).
STEAM_APP_ID=""
pgrep -q steam_osx && STEAM_APP_ID=1091500
(cd "$GAME_DIR" || exit 2
    [[ -z "$STEAM_APP_ID" ]] || export SteamAppId=$STEAM_APP_ID SteamGameId=$STEAM_APP_ID
    # rttidump: RED4ext writes logs/rtti_layout_macos.json when Running is entered (main menu checks then exit).
    [[ "$SCENARIO" != rttidump ]] || export RED4EXT_DUMP_RTTI=1
    CP_AUTOTEST="$SCENARIO" DYLD_INSERT_LIBRARIES="$R4E_DIR/RED4ext.dylib" \
    exec "$GAME_BIN" $START_ARGS >"$RUN_DIR/stdout.log" 2>&1) &
GAME_PID=$!

# --- watch ----------------------------------------------------------------------------------------
shot() { # screenshot of the game window, if it has one
    local id
    id=$(swift "$TOOLS_DIR/window-id.swift" "$GAME_PID" 2>/dev/null || true)
    [[ -n "$id" ]] && screencapture -x -o -l "$id" "$RUN_DIR/$1.png" 2>/dev/null || true
}
press_key() { # <macOS key code>: bring the game window to the front, then press the key
    osascript -e "tell application \"System Events\" to set frontmost of (first process whose unix id is $GAME_PID) to true" \
        -e "delay 1" -e "tell application \"System Events\" to key code $1" >>"$RUN_DIR/keys.log" 2>&1 || true
}
OUTCOME=timeout
SHOT_AT=$((START + 60))
START_PRESSES=0
NEXT_START_PRESS=$((START + 40))
while kill -0 "$GAME_PID" 2>/dev/null; do
    now=$(date +%s)
    if [[ -f "$LOGS_DIR/autotest.log" ]] &&
        awk '/LOAD_LAST_CHECKPOINT/{l=1} l&&/PLAYER_ATTACHED/{f=1} /"event":"DONE"/{f=1} END{exit !f}' "$LOGS_DIR/autotest.log"; then
        OUTCOME=results
        # CP_WORLD_HOLD=N keeps the game running N more seconds (e.g. so the in-world HUD is built), with a screenshot
        # before and after; CP_KEYCODE=<macOS virtual key code> presses that key in the game window in between
        # (needs Accessibility permission for the terminal).
        if [[ -n "${CP_WORLD_HOLD:-}" ]]; then
            sleep "$CP_WORLD_HOLD"; shot hold-before
            if [[ -n "${CP_KEYCODE:-}" ]]; then
                press_key "$CP_KEYCODE"
                sleep 3; shot hold-after
            fi
        else
            sleep 5
        fi
        break
    fi
    if [[ $now -ge $SHOT_AT ]]; then shot "t$((now - START))"; SHOT_AT=$((now + 60)); fi
    if [[ -z "$START_ARGS" && $START_PRESSES -lt 4 && $now -ge $NEXT_START_PRESS ]] &&
        ! grep -q MAIN_MENU "$LOGS_DIR/autotest.log" 2>/dev/null; then
        press_key 49; START_PRESSES=$((START_PRESSES + 1)); NEXT_START_PRESS=$((now + 15))
    fi
    if [[ $((now - START)) -ge $TIMEOUT ]]; then break; fi
    sleep 2
done
if kill -0 "$GAME_PID" 2>/dev/null; then
    shot final
    kill -TERM "$GAME_PID" 2>/dev/null || true
    for _ in $(seq 10); do kill -0 "$GAME_PID" 2>/dev/null || break; sleep 1; done
    kill -9 "$GAME_PID" 2>/dev/null || true
else
    [[ $OUTCOME == timeout ]] && OUTCOME=exited
fi
wait "$GAME_PID" 2>/dev/null && EXIT_CODE=0 || EXIT_CODE=$?
GAME_PID=""
for _ in $(seq 15); do find "$HOME/Library/Logs/DiagnosticReports" -name "Cyberpunk2077*.ips" -newer "$RUN_DIR/.start" | grep -q . && break; [[ $EXIT_CODE -eq 0 || $EXIT_CODE -eq 143 ]] && break; sleep 1; done # ReportCrash can take a few seconds

# --- collect --------------------------------------------------------------------------------------
cp "$LOGS_DIR"/{hookstats.json,milestones.log,autotest.log,rtti_layout_macos.json} "$RUN_DIR/" 2>/dev/null || true
latest_log=$(ls -t "$LOGS_DIR"/red4ext*.log 2>/dev/null | head -1 || true)
[[ -n "$latest_log" ]] && cp "$latest_log" "$RUN_DIR/red4ext.log"
find "$R4E_DIR/plugins" -name '*.log' -newer "$RUN_DIR/.start" -exec cp {} "$RUN_DIR/" \; 2>/dev/null || true
find "$HOME/Library/Logs/DiagnosticReports" -name 'Cyberpunk2077*.ips' -newer "$RUN_DIR/.start" -exec cp {} "$RUN_DIR/" \; 2>/dev/null || true

# results.json from the autotest's JSON lines (red4ext/logs/autotest.log)
python3 - "$RUN_DIR" <<'PY'
import json, os, sys
run = sys.argv[1]
events = []
try:
    lines = open(os.path.join(run, "autotest.log"), errors="replace").read().splitlines()
except OSError:
    lines = []
for line in lines:
    try:
        events.append(json.loads(line))
    except ValueError:
        pass
if events:
    # Only what happens after the load request counts (the main-menu scene attaches a puppet too).
    loads = [i for i, e in enumerate(events) if e.get("event") == "LOAD_LAST_CHECKPOINT"]
    if loads:
        events = events[loads[0]:]
        done = any(e.get("event") == "PLAYER_ATTACHED" for e in events)
    else:
        done = any(e.get("event") == "DONE" for e in events)
    checks = [e for e in events if e.get("event") == "CHECK"]
    res = {"pass": done and bool(checks) and all(c.get("pass") for c in checks), "checks": checks, "events": events}
    json.dump(res, open(os.path.join(run, "results.json"), "w"), indent=2)
PY

# --- verdict --------------------------------------------------------------------------------------
python3 - "$RUN_DIR" "$SCENARIO" "$OUTCOME" "$EXIT_CODE" <<'EOF'
import glob, json, os, sys
run, scenario, outcome, code = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
fails = []
crashes = glob.glob(os.path.join(run, "*.ips"))
if crashes:
    fails.append(f"crash report: {os.path.basename(crashes[0])}")
try:
    stats = json.load(open(os.path.join(run, "hookstats.json")))
    hooks = stats["hooks"]
    if not hooks:
        fails.append("hookstats.json lists no hooks")
    for h in hooks:
        if not h["installed"] or h["install_kr"] != 0:
            fails.append(f"hook {h['name']} not installed (kr={h['install_kr']})")
        elif h["hits"] < 1 and h.get("owner", "RED4ext") == "RED4ext":
            fails.append(f"hook {h['name']} installed but never hit")
        elif h["hits"] < 1:
            print(f"[cp-run]   note: {h.get('owner')} hook {h['name'][:60]} not hit in this scenario")
except (OSError, ValueError, KeyError) as e:
    fails.append(f"hookstats.json missing or unreadable ({e})")
try:
    milestones = open(os.path.join(run, "milestones.log")).read()
except OSError:
    milestones = ""
if "ENTER Running" not in milestones:
    fails.append("Running state never entered (milestones.log)")
for line in milestones.splitlines():
    parts = line.split()
    if parts[:1] == ["CHECK"] and parts[-1] != "pass":
        fails.append(f"RED4ext self-check {parts[1]}: {parts[-1]}")
if scenario != "boot":
    try:
        res = json.load(open(os.path.join(run, "results.json")))
        if not res.get("pass"):
            bad = [c.get("name") for c in res.get("checks", []) if not c.get("pass")]
            fails.append(f"results.json pass=false {bad}")
    except (OSError, ValueError) as e:
        fails.append(f"results.json missing: autotest.log has no events ({e})")
verdict = "PASS" if not fails else "FAIL"
summary = {"scenario": scenario, "verdict": verdict, "outcome": outcome, "exit_code": code, "failures": fails}
json.dump(summary, open(os.path.join(run, "verdict.json"), "w"), indent=2)
print(f"[cp-run] {verdict} {scenario} ({outcome}, exit {code}) -> {run}")
for f in fails:
    print(f"[cp-run]   - {f}")
sys.exit(0 if verdict == "PASS" else 1)
EOF
