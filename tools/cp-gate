#!/bin/bash
# Offline gate for patch days and releases. It never launches the game.
#
#   tools/cp-gate [PLUGIN.dylib:SOURCE_DIR ...]
#
# Checks, in order:
#   1. The installed game binary's UUID matches the address DB's uuid. A new game patch invalidates every verified
#      address and the layout dump.
#   2. The address DB's verified entries pass validate_addresses.py --verified-only.
#   3. The layout dump is from the same binary, and each plugin's classes match it (sdk_layout_diff.py).
#   4. Every address hash compiled into each plugin is verified (red4ext_plugin_check, the loader's own gate).
#   5. Each plugin's native script imports (SOURCE_DIR/../scripts) name types and property types the game has
#      (script_type_check.py). The game refuses every script on one mismatch ("Failed to initialize scripts data!").
# With no arguments it checks the TweakXL, ModMenu, ArchiveXL and Codeware builds next to this repo.
# Exit 0 only if every check passes.
#
# CP_GATE_NO_GAME=1 skips check 1 only (CI runners have no game). Every other check still runs.
#
# Patch-day procedure when check 1 fails:
#   1. tools/cp-run rttidump        -> copy logs/rtti_layout_macos.json to RED4ext.SDK/data/
#   2. Re-verify every "verified" DB entry against the new binary (RED4ext.SDK/docs/re/*.md lists the evidence),
#      update offsets and uuid, and clear "verified" on anything not re-confirmed.
#   3. Re-run this gate.
set -uo pipefail

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$TOOLS_DIR/.."
WS="$ROOT/.."
SDK="$WS/RED4ext.SDK"
DB="$SDK/cyberpunk2077_addresses.json"
DUMP="$SDK/data/rtti_layout_macos.json"
GAME_DIR="${CP2077_GAME_DIR:-$HOME/Library/Application Support/Steam/steamapps/common/Cyberpunk 2077}"
GAME_BIN="${CP2077_BINARY:-$GAME_DIR/Cyberpunk2077.app/Contents/MacOS/Cyberpunk2077}"
CHECK="${CP2077_GATE_CHECK:-$ROOT/build-dev/bin/red4ext_plugin_check}"

fail=0
step() { echo "== $*"; }
bad() { echo "FAIL: $*"; fail=1; }

normalize() { tr -d '-' | tr '[:lower:]' '[:upper:]'; }
dbuuid=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("uuid",""))' "$DB" | normalize)
dumpuuid=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("uuid",""))' "$DUMP" | normalize)

step "game binary vs address DB"
if [[ "${CP_GATE_NO_GAME:-}" == 1 ]]; then
    echo "SKIP game binary check (CP_GATE_NO_GAME=1) / DB $dbuuid / dump $dumpuuid"
else
    gameuuid=$(dwarfdump --uuid "$GAME_BIN" 2>/dev/null | awk '/arm64/{print $2}' | normalize)
    echo "game $gameuuid / DB $dbuuid / dump $dumpuuid"
    [[ -n "$gameuuid" && "$gameuuid" == "$dbuuid" ]] || bad "the game binary does not match the address DB (patch day: see the header of this script)"
fi
[[ "$dumpuuid" == "$dbuuid" ]] || bad "the layout dump is from another binary (run tools/cp-run rttidump)"

# cp-dev installs RED4ext's pinned copy of the DB, so it must be the one checked here.
cmp -s "$DB" "$ROOT/deps/red4ext.sdk/cyberpunk2077_addresses.json" ||
    bad "deps/red4ext.sdk's address DB differs from RED4ext.SDK's (push the SDK, then tools/bump-sdk)"

step "verified address entries"
python3 "$SDK/scripts/validate_addresses.py" --verified-only --quiet || bad "validate_addresses.py"

if [[ $# -eq 0 ]]; then
    set -- "$WS/cp2077-tweak-xl/build-dev/TweakXL.dylib:$WS/cp2077-tweak-xl/src" \
        "$WS/cp2077-modmenu/build-dev/libModMenu.dylib:$WS/cp2077-modmenu/src" \
        "$WS/cp2077-archive-xl-macos/build-dev/ArchiveXL.dylib:$WS/cp2077-archive-xl-macos/src" \
        "$WS/cp2077-codeware/build-dev/Codeware.dylib:$WS/cp2077-codeware/src"
fi
# Plugins register script types of their own; their sources say which (Codeware's are used by other plugins' scripts).
plugin_srcs=()
for spec in "$@"; do plugin_srcs+=(--plugin-src "${spec#*:}"); done

[[ -x "$CHECK" ]] || { bad "build red4ext_plugin_check first (cmake --build build-dev)"; exit 1; }

# red4ext_plugin_check only knows the hashes in the DB, so a hash the SDK or a plugin defines but the DB lacks would
# pass and resolve to null in game. Check against a copy of the DB that lists every such hash as unverified.
GATE_DB=$(mktemp -t cp-gate-db)
trap 'rm -f "$GATE_DB"' EXIT
python3 - "$DB" "$GATE_DB" "$SDK" "$@" <<'PY'
import json, re, sys
from pathlib import Path
db_path, out_path, sdk, specs = sys.argv[1], sys.argv[2], Path(sys.argv[3]), sys.argv[4:]
db = json.loads(Path(db_path).read_text())
known = {int(e["hash"]) for e in db["Addresses"]}
pattern = re.compile(r"constexpr (?:std::)?uint32_t (\w+) = (0x[0-9A-Fa-f]+|\d+);")
# Address hashes live in the SDK's Detail/AddressHashes.hpp and in each plugin's Red/Addresses/*.hpp.
files = [sdk / "include/RED4ext/Detail/AddressHashes.hpp"]
files += [f for spec in specs for f in Path(spec.split(":", 1)[1]).glob("Red/Addresses/*.hpp")]
missing = {}
for f in files:
    for name, value in pattern.findall(f.read_text(errors="ignore")):
        if int(value, 0) not in known:
            missing.setdefault(int(value, 0), name)
db["Addresses"] += [{"hash": str(h), "offset": "1:0x0", "verified": False} for h in sorted(missing)]
Path(out_path).write_text(json.dumps(db))
print(f"absent from the DB, treated as unverified: {', '.join(sorted(missing.values())) or 'none'}")
PY
for spec in "$@"; do
    dylib=${spec%%:*}
    src=${spec#*:}
    step "$(basename "$dylib")"
    [[ -f "$dylib" ]] || { bad "$dylib not built"; continue; }
    "$CHECK" "$GATE_DB" "$dylib" || bad "$(basename "$dylib") uses unverified addresses"
    python3 "$SDK/scripts/sdk_layout_diff.py" --plugin-sources "$src" | tail -1
    python3 "$SDK/scripts/sdk_layout_diff.py" --plugin-sources "$src" >/dev/null || bad "$(basename "$dylib") uses classes whose macOS layout differs from the SDK"
    if [[ -d "$src/../scripts" ]]; then
        python3 "$TOOLS_DIR/script_type_check.py" "$DUMP" "$src/../scripts" "${plugin_srcs[@]}" ||
            bad "$(basename "$dylib") scripts import native types the game does not have"
    fi
done

[[ $fail -eq 0 ]] && echo "PASS" || echo "FAILED"
exit $fail
