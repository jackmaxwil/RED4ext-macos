#!/bin/bash
# Ray tracing benchmark: runs tools/cp-run rtbench once per ray tracing mode, then writes the report.
#
#   tools/rtbench [mode...]      modes: raster rt_ultra rt_psycho pt (default: all four)
#
# Each run sets its mode in UserSettings.json (cp-run's CP_SETTINGS; your settings are restored afterwards), always
# with MetalFX Quality upscaling and no frame generation, and loads the MetalFX Denoiser plugin with its Metal tracer
# for frame times and frame traces. Like every cp-run test, the game runs in the background and never takes focus.
# Report: ../cp2077-metalfx-denoiser/scripts/rtbench_report.py over the runs, printed and saved next to the last run.
# RTBENCH_SCENARIO picks another scenario with the same per-mode setup (passcost: what parts of the frame cost);
# RTBENCH_SKIP is the shader name pattern passcost drops as "listed" (written as the plugin's skip-fingerprints.txt).
# RTBENCH_CVARS="<group>/<name>=<value>,..." sets engine config variables for every run (the plugin's
# cvar-startup.txt, deleted afterwards); RTBENCH_LABEL is appended to the mode in tags (e.g. rt_ultra-nonrd).
# RTBENCH_EXPERIMENTS is cvarbatch's list of config variable experiments (copied as the plugin's cvar-experiments.txt).
# CP_INI (an engine config file for every run, see cp-run) passes through.
# RTBENCH_DUMP="<pipeline label or function name>,..." adds the textures those dispatches declare to the dump scenario's
# PNGs (the plugin's dump-pipes.txt, deleted afterwards).
# RTBENCH_DENOISE is the MetalFX Denoiser plugin's starting mode (off by default, whatever config.toml and ModMenu say;
# scenarios switch it with "denoise" requests); RTBENCH_DENOISE='' leaves it to config.toml and ModMenu.
# RTBENCH_PLUGINS adds plugins to load (comma-separated directory names, e.g. ModMenu).
# RTBENCH_PRESET is the MetalFX quality preset as <value>@<index> (Quality@1 by default; Balanced@2, Performance@3).
# RTBENCH_CAPTURE=1 also writes an Xcode GPU capture (.gputrace) of one frame at the first spot (Metal's capture
# layer is enabled for the whole run, so frame times are not comparable with runs without it).
set -euo pipefail
TOOLS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPORT="$TOOLS/../../cp2077-metalfx-denoiser/scripts/rtbench_report.py"
MODES=("$@")
[[ ${#MODES[@]} -gt 0 ]] || MODES=(raster rt_ultra rt_psycho pt)

RT=/graphics/raytracing
# List options are value@index. The game applies the index, and for ResolutionScaling the index does not follow the
# labels: index 1 runs the MetalFX temporal scaler (a saved "FSR2"@1 did), index 3 runs FSR3 (traced: ffx_fsr3upscaler
# passes). The other lists follow the order rtbench logs: MetalFX Auto Quality Balanced Performance Dynamic;
# RayTracedLighting Off Medium Ultra Psycho.
COMMON="/graphics/presets:ResolutionScaling=MetalFX@1,/graphics/presets:MetalFX=${RTBENCH_PRESET:-Quality@1},/graphics/presets:FrameGeneration=Off@0"
RT_ON="$RT:RayTracing=true,$RT:RayTracedReflections=true,$RT:RayTracedSunShadows=true,$RT:RayTracedLocalShadows=true"
# Shader names for the pass lists: an index of the game's shader caches (derived from game files, not committed).
INDEX="$TOOLS/../../cp2077-metalfx-denoiser/scripts/shader_index.json"
[[ -s "$INDEX" ]] || python3 "$(dirname "$REPORT")/shader_index.py" >"$INDEX"
SCENARIO=${RTBENCH_SCENARIO:-rtbench}
if [[ -n "${RTBENCH_SKIP:-}" ]]; then
    GAME_DIR="${CP2077_GAME_DIR:-$HOME/Library/Application Support/Steam/steamapps/common/Cyberpunk 2077}"
    python3 "$(dirname "$REPORT")/skip_list.py" "$RTBENCH_SKIP" \
        >"$GAME_DIR/red4ext/plugins/MetalFXDenoiser/skip-fingerprints.txt"
fi
if [[ -n "${RTBENCH_EXPERIMENTS:-}" ]]; then
    GAME_DIR="${CP2077_GAME_DIR:-$HOME/Library/Application Support/Steam/steamapps/common/Cyberpunk 2077}"
    cp "$RTBENCH_EXPERIMENTS" "$GAME_DIR/red4ext/plugins/MetalFXDenoiser/cvar-experiments.txt"
fi
PLUGIN_DIR="${CP2077_GAME_DIR:-$HOME/Library/Application Support/Steam/steamapps/common/Cyberpunk 2077}/red4ext/plugins/MetalFXDenoiser"
rm -f "$PLUGIN_DIR/cvar-startup.txt" "$PLUGIN_DIR/dump-pipes.txt"
trap 'rm -f "$PLUGIN_DIR/cvar-startup.txt" "$PLUGIN_DIR/dump-pipes.txt"' EXIT
if [[ -n "${RTBENCH_CVARS:-}" ]]; then
    tr ',' '\n' <<<"$RTBENCH_CVARS" >"$PLUGIN_DIR/cvar-startup.txt"
fi
[[ -n "${RTBENCH_DUMP:-}" ]] && echo "$RTBENCH_DUMP" >"$PLUGIN_DIR/dump-pipes.txt"
runs=()
for mode in "${MODES[@]}"; do
    case "$mode" in
    raster) settings="$RT:RayTracing=false,$RT:RayTracedPathTracing=false" ;;
    rt_ultra) settings="$RT_ON,$RT:RayTracedLighting=Ultra@2,$RT:RayTracedPathTracing=false" ;;
    rt_psycho) settings="$RT_ON,$RT:RayTracedLighting=Psycho@3,$RT:RayTracedPathTracing=false" ;;
    pt) settings="$RT_ON,$RT:RayTracedLighting=Ultra@2,$RT:RayTracedPathTracing=true" ;;
    *) echo "unknown mode: $mode (raster rt_ultra rt_psycho pt)" >&2; exit 2 ;;
    esac
    [[ "${RTBENCH_CAPTURE:-0}" == 1 ]] && export MTL_CAPTURE_ENABLED=1
    CP_SETTINGS="$COMMON,$settings" CP_TAG="$mode${RTBENCH_LABEL:-}" CP_PLUGINS="MetalFXDenoiser${RTBENCH_PLUGINS:+,$RTBENCH_PLUGINS}" METALFX_TRACE=1 METALFX_DENOISE="${RTBENCH_DENOISE-off}" \
        "$TOOLS/cp-run" "$SCENARIO" --timeout 900 || echo "[rtbench] $mode run failed; continuing"
    runs+=("$(ls -td "$TOOLS"/../runs/*-"$SCENARIO" | head -1)")
done
python3 "$REPORT" "${runs[@]}" | tee "${runs[${#runs[@]}-1]}/rtbench.md"
